# ==================================================
# VOXO Backend — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ==================================================

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser/app origins for CORS
CORS_ORIGINS=http://localhost:19006

MONGODB_URI=mongodb://localhost:27017/voxo
REDIS_URL=redis://localhost:6379

# JWT — use long, random secrets in production (e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Meta WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_BUSINESS_ACCOUNT_ID=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0

# Set true only in development/test — swaps the Meta client for a mock
META_MOCK_MODE=true

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# Seed script (Phase 1 bootstrap master admin — see backend/src/scripts/seed.ts)
SEED_TENANT_NAME=Demo Tenant
SEED_MASTER_ADMIN_EMAIL=admin@example.com
SEED_MASTER_ADMIN_PASSWORD=ChangeMe123!
# Demo WhatsApp account/contacts/conversation/template/subscription/wallet
# credit — seeded automatically outside production; set true to also seed it
# on a production deployment that's actually just for testing, like a
# personal Render instance (never set this on a real customer tenant).
SEED_DEMO_DATA=false
