# ==================================================
# VOXO Mobile — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env.
#
# Vars prefixed EXPO_PUBLIC_ are inlined into the JS bundle at build time
# (Expo's documented mechanism — see https://docs.expo.dev/guides/environment-variables/).
# That means anything here ships inside the APK and is readable by anyone
# who has it. NEVER put a secret (API keys, Meta credentials, etc.) in an
# EXPO_PUBLIC_ variable — only public, non-sensitive values like a base URL
# belong here. All real secrets stay server-side (see backend/.env.example).
# ==================================================

# Base URL of the VOXO backend's REST API (see backend/src/app.ts — the
# /api prefix is appended by src/utils/env.ts, don't include it here).
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Socket.IO server URL — normally the same host as EXPO_PUBLIC_API_URL,
# split out since some deployments front them differently (e.g. separate
# WebSocket load balancer).
EXPO_PUBLIC_SOCKET_URL=http://10.0.2.2:4000
