<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- Sharing a pin in a chat. COARSE only: a customer being told where the
       shop is does not need the agent's position to the metre, and the fine
       permission is a far larger thing to ask for on a screen that is only
       sending a map link. Declared here because the committed android/ tree
       is what Gradle builds — there is no prebuild step to apply the
       expo-location plugin's own manifest entries. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <!-- Saving a VOXO contact into the phone's address book (expo-contacts).
       Added by hand to match the expo-contacts config plugin, because this
       native project is committed rather than regenerated: `expo prebuild`
       would overwrite the release signing config and ProGuard rules. -->
  <!-- Video calls, and nothing else. expo-image-picker takes photos
       through the system camera app, which needs no permission here — so
       before video calling existed this app genuinely had no use for it
       and correctly did not ask. -->
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.READ_CONTACTS"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <!-- The SMS inbox screen under Settings — reads the device's own SMS
       content provider (react-native-get-sms-android) to surface messages
       matching a small fixed keyword list, never the whole inbox. Runtime-
       requested, same as camera/contacts; the OS prompt itself is the
       consent, same reasoning as every other dangerous permission here. -->
  <uses-permission android:name="android.permission.READ_SMS"/>
  <!-- The lead-SMS auto-reply (Settings > Private chat): catches an
       incoming SMS matching a small fixed keyword list and replies with
       this agent's personal chat link, off the SmsAutoReplyReceiver
       below — entirely native, so it fires even if VOXO isn't running.
       Off by default; the agent switches it on themselves. -->
  <uses-permission android:name="android.permission.RECEIVE_SMS"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <!-- "Send invitation via SMS" on a conversation: sends the private-chat
       link straight from the device's own SIM (react-native-get-sms-android
       autoSend), instead of only opening the SMS app composer for the agent
       to tap send themselves. Runtime-requested like every other dangerous
       permission here. -->
  <uses-permission android:name="android.permission.SEND_SMS"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <!-- Raises the incoming-call UI over the lock screen, which is the one
       thing a ringing notification has to do that an ordinary one does
       not: a call the user must unlock to find is a call they miss.
       Granted by default below Android 14; from 14 it is reserved for
       calling and alarm apps, which this is. Used by the call
       notification alone — never for messages, which stay ordinary
       notifications on their own channel. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WRITE_CONTACTS"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false" android:fullBackupContent="@xml/secure_store_backup_rules" android:dataExtractionRules="@xml/secure_store_data_extraction_rules">
    <!-- react-native-webrtc ships a screen-capture service in its own
         manifest. VOXO makes audio calls only and never starts it, but a
         declared foregroundServiceType="mediaProjection" drags in the
         Android 14 media-projection obligations (an extra permission, and
         a Play Console declaration) for a capability the app does not
         have. Removed at merge time rather than permitted. -->
    <service android:name="com.oney.WebRTCModule.MediaProjectionService" tools:node="remove"/>
    <!-- See SmsAutoReplyReceiver.kt. android:permission restricts who can
         broadcast this to apps holding BROADCAST_SMS — the OS itself,
         never a third-party app pretending to be it. -->
    <receiver
      android:name=".SmsAutoReplyReceiver"
      android:exported="true"
      android:permission="android.permission.BROADCAST_SMS">
      <intent-filter>
        <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
      </intent-filter>
    </receiver>
    <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_icon_color"/>
    <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/notification_icon"/>
    <meta-data android:name="expo.modules.notifications.default_notification_color" android:resource="@color/notification_icon_color"/>
    <meta-data android:name="expo.modules.notifications.default_notification_icon" android:resource="@drawable/notification_icon"/>
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.ENABLE_BSDIFF_PATCH_SUPPORT" android:value="true"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|assetsPaths" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="voxo"/>
      </intent-filter>
    </activity>
  </application>
</manifest>