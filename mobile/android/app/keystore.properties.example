# Copy this file to `keystore.properties` (same directory) and fill in
# real values to produce a genuinely production-signed release APK/AAB.
# `keystore.properties` and any `.keystore`/`.jks` file are gitignored —
# never commit either. See BUILD.md for the full walkthrough, including
# the `keytool` command that generates the keystore itself.
#
# storeFile is relative to this `android/app/` directory.
storeFile=voxo-release.keystore
storePassword=CHANGE_ME
keyAlias=voxo-release
keyPassword=CHANGE_ME
