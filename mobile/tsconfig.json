{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // app.config.ts is a build-time Node script (it reads the filesystem to
    // detect google-services.json), and it is deliberately inside
    // "include" so it is typechecked like everything else. Without this it
    // fails on node:fs/node:path/__dirname, which are perfectly valid in
    // the only context that file ever runs in.
    // "jest" so the test files beside the code they cover typecheck like
    // everything else rather than being quietly excluded.
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "app.config.ts"],
  "exclude": ["node_modules", "android", "ios"]
}
