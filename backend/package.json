    "test:watch": "jest --runInBand --watch",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.72.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.41.1",
